{
  "name": "maison-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack clothing store e-commerce platform with manual order confirmation and an administration dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:acceptance": "tsx scripts/acceptance-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true
  }
}
