// Clothing store database schema.
//
// Portability: enumerations are stored as strings and validated in
// src/lib/constants.ts so the same schema works on SQLite (development)
// and PostgreSQL (production). Monetary amounts are integers in
// millimes (1 TND = 1000 millimes) to avoid floating point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & access ───────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  fullName     String
  passwordHash String
  /// CUSTOMER | OWNER | MANAGER | EMPLOYEE
  role         String    @default("CUSTOMER")
  /// Comma separated permission list overriding role defaults (staff only)
  permissions  String?
  isActive     Boolean   @default(true)
  locale       String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile        CustomerProfile?
  sessions       Session[]
  cart           Cart?
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  notifications  Notification[]
  returnRequests ReturnRequest[]
  statusChanges  OrderStatusHistory[]
  orderNotes     OrderNote[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  couponUses     CouponRedemption[]

  @@index([role])
  @@index([createdAt])
}

model CustomerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              String?
  city                 String?
  regionId             String?
  region               DeliveryRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  postalCode           String?
  deliveryInstructions String?
  updatedAt            DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 hash of the session token (the raw token only lives in the cookie)
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  remember   Boolean  @default(false)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────── Catalog structure ───────────────────────────

/// Top-level department (Homme / Femme / Enfant / ...)
model Category {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  nameAr      String?
  nameEn      String?
  /// MEN | WOMEN | KIDS | UNISEX | BABY
  audience    String
  description String?
  imageUrl    String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  sizeChartId String?
  sizeChart   SizeChart?    @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories Subcategory[]
  products      Product[]
  promotions    PromotionCategory[]
  coupons       CouponCategory[]
}

model Subcategory {
  id          String     @id @default(cuid())
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug        String
  name        String
  nameAr      String?
  nameEn      String?
  /// Generic product type used by search, e.g. "jacket", "sneakers"
  productType String?
  /// CLOTHING | SHOES | AGE | ONE_SIZE — default size system proposed to admins
  sizeType    String     @default("CLOTHING")
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  sizeChartId String?
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products   Product[]
  promotions PromotionSubcategory[]

  @@unique([categoryId, slug])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameAr      String?
  nameEn      String?
  description String?
  /// SUMMER | WINTER | SPRING | AUTUMN | ALL
  season      String    @default("ALL")
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Material {
  id        String            @id @default(cuid())
  name      String            @unique
  nameAr    String?
  nameEn    String?
  products  ProductMaterial[]
}

model Color {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameAr    String?
  nameEn    String?
  hex       String
  sortOrder Int      @default(0)

  variants  ProductVariant[]
  images    ProductImage[]
}

model Size {
  id        String  @id @default(cuid())
  label     String
  /// CLOTHING | SHOES | AGE | ONE_SIZE | OTHER
  type      String
  sortOrder Int     @default(0)

  variants ProductVariant[]

  @@unique([type, label])
}

model SizeChart {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  nameEn      String?
  description String?
  unit        String   @default("cm")
  /// JSON: string[] measurement names (e.g. ["Chest","Waist"])
  columns     String
  /// JSON: { size: string, values: string[] }[]
  rows        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products      Product[]
  categories    Category[]
  subcategories Subcategory[]
}

// ─────────────────────────── Products ───────────────────────────

model Product {
  id               String       @id @default(cuid())
  slug             String       @unique
  sku              String?      @unique
  name             String
  shortDescription String?
  description      String
  /// MEN | WOMEN | KIDS | UNISEX | BABY
  audience         String
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId    String?
  subcategory      Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  brandId          String?
  brand            Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collectionId     String?
  collection       Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// SUMMER | WINTER | SPRING | AUTUMN | ALL
  season           String       @default("ALL")
  /// SLIM | REGULAR | OVERSIZED | RELAXED | null
  fitType          String?
  weightGrams      Int?
  careInstructions String?
  countryOfOrigin  String?
  /// One characteristic per line
  characteristics  String?
  /// Base price in millimes
  price            Int
  /// Promotional price in millimes (optional)
  salePrice        Int?
  /// DRAFT | PUBLISHED | ARCHIVED
  status           String       @default("DRAFT")
  isFeatured       Boolean      @default(false)
  isNewArrival     Boolean      @default(false)
  isBestSeller     Boolean      @default(false)
  isOnSale         Boolean      @default(false)
  sizeChartId      String?
  sizeChart        SizeChart?   @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  metaTitle        String?
  metaDescription  String?

  // Denormalised values maintained by src/server/pricing.ts and inventory.ts
  minPrice         Int          @default(0)
  maxDiscountPct   Int          @default(0)
  isDiscounted     Boolean      @default(false)
  totalAvailable   Int          @default(0)
  soldCount        Int          @default(0)
  ratingAvg        Float        @default(0)
  ratingCount      Int          @default(0)
  /// Normalised, accent-free text of every searchable field in every language
  searchText       String       @default("")

  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  translations ProductTranslation[]
  materials    ProductMaterial[]
  images       ProductImage[]
  variants     ProductVariant[]
  wishlistedBy WishlistItem[]
  reviews      Review[]
  orderItems   OrderItem[]
  promotions   PromotionProduct[]
  coupons      CouponProduct[]

  @@index([status, audience])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([minPrice])
  @@index([soldCount])
  @@index([publishedAt])
  @@index([name])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ar | en (fr is stored on Product)
  locale           String
  name             String
  shortDescription String?
  description      String?
  careInstructions String?

  @@unique([productId, locale])
  @@index([name])
}

model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  percentage Int

  @@unique([productId, materialId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Null = shared by all colors
  colorId   String?
  color     Color?   @relation(fields: [colorId], references: [id], onDelete: SetNull)
  /// IMAGE | VIDEO
  kind      String   @default("IMAGE")
  /// FRONT | BACK | SIDE | DETAIL | OTHER
  view      String   @default("OTHER")
  /// Storage key without size suffix, e.g. "products/abc/img-xyz"
  storageKey String
  /// Public URL of the large rendition (or the video)
  url       String
  /// Public URL of the thumbnail rendition
  thumbUrl  String
  width     Int?
  height    Int?
  alt       String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

/// A specific product + color + size combination with its own stock.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String?
  color     Color?   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  sizeId    String?
  size      Size?    @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  /// "<colorId|->:<sizeId|->" — enforces one variant per combination (NULL-safe)
  variantKey String
  sku       String?  @unique
  /// Override of the product price (millimes)
  price     Int?
  salePrice Int?
  /// Physical units on hand
  stock     Int      @default(0)
  /// Units held by orders awaiting confirmation
  reserved  Int      @default(0)
  /// stock - reserved, maintained atomically by src/server/inventory.ts
  available Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, variantKey])
  @@index([colorId])
  @@index([sizeId])
  @@index([available])
}

// ─────────────────────────── Customer engagement ───────────────────────────

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Guest cart token (cookie), null once attached to a user
  guestToken   String?    @unique
  couponCode   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  /// Unit price seen when added; used to warn about price changes
  seenPrice Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  body               String
  /// PENDING | APPROVED | REJECTED
  status             String        @default("PENDING")
  isVerifiedPurchase Boolean       @default(false)
  adminReply         String?
  repliedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  photos             ReviewPhoto[]

  @@unique([productId, userId])
  @@index([status])
}

model ReviewPhoto {
  id         String @id @default(cuid())
  reviewId   String
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  thumbUrl   String
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─────────────────────────── Orders ───────────────────────────

model Order {
  id                   String   @id @default(cuid())
  number               String   @unique
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// PENDING | CONFIRMED | PREPARING | SHIPPED | DELIVERED | CANCELLED
  status               String   @default("PENDING")
  /// HELD (pending reservation) | DEDUCTED | RELEASED | RESTOCKED
  stockState           String   @default("HELD")

  // Customer snapshot at time of ordering
  customerName         String
  customerPhone        String
  customerEmail        String
  /// DELIVERY | PICKUP
  deliveryMethod       String   @default("DELIVERY")
  address              String
  city                 String
  regionName           String
  regionId             String?
  postalCode           String?
  deliveryInstructions String?

  subtotal             Int
  discountTotal        Int      @default(0)
  couponCode           String?
  couponDiscount       Int      @default(0)
  shippingFee          Int      @default(0)
  total                Int
  currency             String   @default("TND")
  /// CASH_ON_DELIVERY (manual), no online payment
  paymentMethod        String   @default("CASH_ON_DELIVERY")
  locale               String?

  cancellationReason   String?
  deliveryCompany      String?
  trackingNumber       String?
  deliveryNotes        String?
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items          OrderItem[]
  history        OrderStatusHistory[]
  notes          OrderNote[]
  returnRequests ReturnRequest[]
  couponUse      CouponRedemption?
  stockMovements StockMovement[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
}

/// Immutable snapshot of what was purchased.
model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName       String
  productSlug       String?
  sku               String?
  colorName         String?
  colorHex          String?
  sizeLabel         String?
  imageUrl          String?
  /// Price before discounts (millimes)
  originalUnitPrice Int
  /// Price paid per unit (millimes)
  unitPrice         Int
  quantity          Int
  lineTotal         Int
  categoryName      String?

  returnItems ReturnItem[]

  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  note          String?
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String?
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─────────────────────────── Returns & exchanges ───────────────────────────

model ReturnRequest {
  id                   String       @id @default(cuid())
  number               String       @unique
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RETURN | EXCHANGE
  type                 String
  /// REQUESTED | APPROVED | REJECTED | RECEIVED | COMPLETED | CANCELLED
  status               String       @default("REQUESTED")
  reason               String
  description          String?
  adminNotes           String?
  rejectionReason      String?
  replacementNote      String?
  restocked            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  items                ReturnItem[]

  @@index([status, createdAt])
  @@index([userId])
}

model ReturnItem {
  id                   String        @id @default(cuid())
  returnRequestId      String
  returnRequest        ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId          String
  orderItem            OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity             Int
  /// Requested size (exchange)
  requestedSize        String?
  /// Replacement variant recorded by the admin
  replacementVariantId String?
  replacementLabel     String?
}

// ─────────────────────────── Promotions ───────────────────────────

model Promotion {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// PERCENT | FIXED
  type        String
  /// Percentage (0-90) or fixed amount in millimes
  value       Int
  /// ALL | PRODUCTS | CATEGORIES | SUBCATEGORIES
  scope       String    @default("ALL")
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products      PromotionProduct[]
  categories    PromotionCategory[]
  subcategories PromotionSubcategory[]
}

model PromotionProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionCategory {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
}

model PromotionSubcategory {
  promotionId   String
  promotion     Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, subcategoryId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  /// PERCENT | FIXED
  type           String
  value          Int
  minOrderAmount Int       @default(0)
  maxUses        Int?
  maxUsesPerUser Int?      @default(1)
  usedCount      Int       @default(0)
  /// ALL | PRODUCTS | CATEGORIES
  scope          String    @default("ALL")
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products    CouponProduct[]
  categories  CouponCategory[]
  redemptions CouponRedemption[]
}

model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

// ─────────────────────────── Delivery & settings ───────────────────────────

model DeliveryRegion {
  id            String            @id @default(cuid())
  name          String            @unique
  nameAr        String?
  fee           Int
  estimatedDays String?
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  profiles      CustomerProfile[]
}

/// Key/value store for typed settings (see src/server/settings.ts)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id        String   @id @default(cuid())
  /// HERO | CATEGORY_TILES | COLLECTIONS | NEW_ARRIVALS | BEST_SELLERS | ON_SALE | FEATURED | PROMO_TEXT | RECENTLY_VIEWED
  type      String
  title     String?
  titleAr   String?
  titleEn   String?
  subtitle  String?
  subtitleAr String?
  subtitleEn String?
  /// JSON with section-specific options (limit, link, image...)
  config    String   @default("{}")
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String    @id @default(cuid())
  /// HERO | PROMO | CATEGORY
  placement  String    @default("HERO")
  title      String
  titleAr    String?
  titleEn    String?
  subtitle   String?
  subtitleAr String?
  subtitleEn String?
  ctaLabel   String?
  ctaLabelAr String?
  ctaLabelEn String?
  linkUrl    String?
  imageUrl   String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model ContentPage {
  id        String   @id @default(cuid())
  /// about | faq | shipping | returns | privacy | terms | contact
  slug      String
  /// fr | ar | en
  locale    String
  title     String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────── Inventory & audit ───────────────────────────

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Change in physical stock (can be negative)
  delta       Int
  /// INITIAL | RESTOCK | ADJUSTMENT | DAMAGED | CORRECTION | ORDER_CONFIRMED | ORDER_CANCELLED | RETURN | EXCHANGE_OUT
  type        String
  reason      String?
  stockBefore Int
  stockAfter  Int
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  createdAt   DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  action    String
  entity    String
  entityId  String?
  /// JSON details
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
