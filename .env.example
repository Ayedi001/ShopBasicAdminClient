# ---------------------------------------------------------------
# Database
# Development uses SQLite (zero setup). For production PostgreSQL,
# see README "Switching to PostgreSQL".
# ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Public base URL of the website (used for SEO, sitemap, CSRF origin checks)
APP_URL="http://localhost:3000"

# Where uploaded images/videos are stored on disk (outside of the build output)
UPLOAD_DIR="./storage/uploads"

# Maximum upload sizes in megabytes
MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=50

# Set to "true" only behind HTTPS (forces Secure cookies). Defaults to true in production.
# COOKIE_SECURE=true

# Seed options. The seed NEVER creates an admin account in production unless
# SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD are explicitly provided.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="ChangeMe-Dev-2026!"
SEED_DEMO_DATA=true

# Optional notification channels (not required). Leave empty to use in-app notifications only.
# NOTIFY_WEBHOOK_URL=""

# Log level: debug | info | warn | error
LOG_LEVEL=info
