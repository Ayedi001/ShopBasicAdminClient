# ---------------------------------------------------------------
# Database — PostgreSQL (required for Vercel / production)
# ---------------------------------------------------------------
# Local: Docker Postgres, or pull from Vercel:
#   npx vercel env pull .env.local
#
# Vercel Marketplace "Prisma Postgres" sets these automatically:
#   DATABASE_URL         = direct connection (migrations / CLI)
#   DATABASE_URL_POOLED  = pooled connection (app runtime)
# ---------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/maison_shop?schema=public"
# DATABASE_URL_POOLED="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Public base URL of the website (SEO, sitemap, CSRF origin checks)
# On Vercel set this to your deployment URL, e.g. https://your-app.vercel.app
APP_URL="http://localhost:3000"

# Where uploaded images/videos are stored on disk (local dev fallback).
UPLOAD_DIR="./storage/uploads"

# Supabase Storage (recommended for persistent product/banner uploads on Vercel).
# Create a PUBLIC bucket named "media" in Supabase → Storage, then set:
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# SUPABASE_STORAGE_BUCKET="media"

# Maximum upload sizes in megabytes
MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=50

# Set to "true" only behind HTTPS (forced Secure cookies). Defaults to true in production.
# COOKIE_SECURE=true

# Seed options. The seed NEVER creates an admin in production unless both are set.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="ChangeMe-Dev-2026!"
SEED_DEMO_DATA=true

# Optional notification channels (not required).
# NOTIFY_WEBHOOK_URL=""

# Log level: debug | info | warn | error
LOG_LEVEL=info
